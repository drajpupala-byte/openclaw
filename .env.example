# ── Required ──────────────────────────────────────────────────────────────────

# Anthropic API key – get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram bot token – create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Optional ──────────────────────────────────────────────────────────────────

# How many conversation turns (user + assistant pairs) to keep per user
# MAX_HISTORY_TURNS=20

# Maximum tokens Claude can generate per response
# MAX_TOKENS=4096

# Custom system prompt for the bot's personality
# SYSTEM_PROMPT=You are Claude, a helpful AI assistant made by Anthropic.
